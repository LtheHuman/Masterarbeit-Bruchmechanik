%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Indentation of TOC
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defbeamertemplate{section in toc}{TUG theme}
{\leavevmode\leftskip=4ex%
  \llap{%
    \usebeamerfont*{section number projected}%
    \usebeamercolor[bg]{section number projected}%
    \vrule width2.25ex height1.85ex depth.4ex%
    \hskip-2.25ex%
    \hbox to2.25ex{\hfil\color{fg}\inserttocsectionnumber\hfil}}%
  \kern1.25ex\inserttocsection\par}

\defbeamertemplate{subsection in toc}{TUG theme}
{\leavevmode\leftskip=6ex\llap{%
    \usebeamercolor[bg]{subsection number projected}%
    \vrule width1ex height1ex\kern1ex}\inserttocsubsection\par}

\setbeamertemplate{itemize/enumerate body begin}{
  \setlength{\leftmargini}{\tugraz@labelwidth}
  \setlength{\leftmarginii}{\tugraz@labelwidth}
  \setlength{\leftmarginiii}{\tugraz@labelwidth}
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  Innertheme with rectangles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setbeamertemplate{sections/subsections in toc}[TUG theme]
\setbeamertemplate{items}[square]
\setbeamertemplate{blocks}[default]  % eckig
%\setbeamertemplate{blocks}[rounded][shadow=true]
%
%
\usecolortheme[named=TUG_rot]{structure}
\setbeamercolor{section in toc}{fg=black,bg=white}
% Block environment with coloured headline
\setbeamercolor{block title}{use=structure,fg=white,bg=Mech_blau}%!50!black}
\setbeamercolor{block title alerted}{use=alerted text,fg=white,bg=alerted
  text.fg!75!black} 
\setbeamercolor{block title example}{use=example text,fg=white,bg=example
  text.fg!75!black} 
%
\setbeamercolor{block body}{parent=normal text,use=block title,bg=lite}%block title.bg!10!bg}
\setbeamercolor{block body alerted}{parent=normal text,use=block title
  alerted,bg=block title alerted.bg!10!bg}
\setbeamercolor{block body example}{parent=normal text,use=block title
  example,bg=block title example.bg!10!bg}
%
\setbeamerfont{block title}{size={}}
\setbeamercovered{transparent}
%
%%%% Abmessungen  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\indleft}{7mm}
\newcommand{\indright}{4mm}
\setbeamersize{text margin left=\indleft}
\setbeamersize{text margin right=\indright}
\newcommand{\tugraz@logosize}{16.5mm}
\newcommand{\tugraz@logosizesmall}{15mm}
\newcommand{\tugraz@instheight}{0.5}
\newcommand{\tugraz@insttrim}{1}
\newcommand{\tugraz@footheight}{0.505}
\newcommand{\tugraz@labelwidth}{5mm}
%%%   HEADER   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setbeamertemplate{headline}[text line]{
  \rule{0pt}{18pt}
  \begin{tikzpicture}[tugtheme]
    \draw (current page.north west) +(0.85*\indleft, -.7) coordinate (lineleft);
    \draw (current page.north east) +(-\indright,-.7) coordinate (lineright);
    \draw[line width=0.5pt] (lineleft) -- (lineright);
    
    \draw (current page.north east) ++(-\indright,-.35) node[left] {\tuglogoscaled[\tugraz@logosizesmall]};
  \end{tikzpicture}
}
%%%   FRAMETITLE   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defbeamertemplate*{frametitle}{TUG theme}
{
  \nointerlineskip
  \usebeamerfont{headline}
  \begin{beamercolorbox}[wd=.9\paperwidth,ht=2.5ex,leftskip=-2mm,
    rightskip=\indright  plus1fil]{}%
    \usebeamerfont*{frametitle}       \insertframetitle
  \end{beamercolorbox}%
}
\addtobeamertemplate{frametitle}{\vskip-3.5mm}{\vskip 1mm} % {space above}{space below}
%%%   FRAME   NUMBER   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defbeamertemplate{frame number block}{institute}{
	\begin{tikzpicture}[tugtheme]
    \node[anchor=north west,yshift=-2mm] at (current page.north west) {\includegraphics[width=\tugraz@instheight cm,trim=0cm 0cm 0cm \tugraz@insttrim cm,clip]{AMBM}};
    \draw (current page.north west)  ++(.25,-1.) node[anchor=center,font={\usebeamercolor[white]{page number in head/foot}}] {\insertframenumber /\inserttotalframenumber};
  \end{tikzpicture}
}
\setbeamertemplate{frame number block}[institute]
%%% FOOTER   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\colorlet{foot}{black!12}
\setbeamercolor{foot}{fg=black,bg=foot}
\setbeamertemplate{footline}[text line]{
  \rule{0pt}{\tugraz@footheight cm}
  %\usebeamerfont{footline}
  \usebeamerfont{date in head/foot}
  \begin{tikzpicture}[tugtheme]
    \draw[fill, foot] (current page.south west) rectangle +(\paperwidth,\tugraz@footheight);
    \draw (current page.south west) ++(\indleft,.2)
    node{\insertshortauthor~$|$~\insertshorttitle};
  \end{tikzpicture}
  \usebeamertemplate{frame number block}
}
%%% TITLEPAGE   %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\defbeamertemplate{title page}{presentation}{
  \drawtitlepagebackground
  
  \begin{tikzpicture}[tugtheme]
    \draw (current page.west) +(\indleft,0) node[font={\usebeamercolor[fg]{title}\usebeamerfont{title}}] {\parbox[b]{.9\paperwidth}{\inserttitle}};

    \draw (current page.west) +(\indleft,-1) node[font={\usebeamercolor[fg]{author}\usebeamerfont{author}}] {\parbox[b]{.9\paperwidth}{\insertauthor}};
    \draw (current page.west) +(\indleft,-1.625) node[font={\usebeamercolor[fg]{date}\usebeamerfont{date}}] {\parbox[t]{.9\paperwidth}{\insertdate}};
    % \draw (current page.south west) +(\indleft,\tugraz@footheight+.3) node[text width=\textwidth,
    % above right,font=\usebeamerfont{footline}] {\strut\insertlogobar};
    
    \node[anchor=north west,yshift=-2mm] at (current page.north west) {\includegraphics[width=\tugraz@instheight cm,trim=0cm 0cm 0cm \tugraz@insttrim cm,clip]{AMBM}};

    \draw (current page.south west) +(\indleft,0.2) node[above
    right,font=\usebeamerfont{headline}] {\insertinstitute};
    
    
    \draw (current page.south east) +(-\indright,0.2) node[above
    left,font=\usebeamerfont{headline}] {{\color{TUG_rot} $>$} www.mech.tugraz.at};
  \end{tikzpicture}
}

\newcommand{\drawtitlepagebackground}{
  \begin{tikzpicture}[tugtheme]
    %\node[anchor=north west] at (current page.north west)
    %{\includegraphics[width=\paperwidth]{background_4-3}};
    \node[anchor=north west] at (-7mm,0.) {\includegraphics[width=\paperwidth]{background_4-3}};
    %\draw (current page.north east) ++(-\indright,-.4) node[anchor=north east] {\tuglogoscaled[\tugraz@logosize]};

    \fill[foot] (current page.south west) rectangle +(\paperwidth,\tugraz@footheight);
  \end{tikzpicture}%
}
\setbeamertemplate{title page}[presentation]
