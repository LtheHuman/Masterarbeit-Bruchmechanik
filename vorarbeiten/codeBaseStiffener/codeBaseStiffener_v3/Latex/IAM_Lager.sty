%%% \SpaceEinspannung{shift}[scale][rotate x][rotate y][rotate z]
%%%     [scale][rotate x][rotate y][rotate z] are optional
\newcommandx{\SpaceEinspannung}[5][2=1.,3=0.,4=0.,5=0.]{%
	\tdplotsetrotatedcoords{#3}{#4}{#5};
  \begin{scope}[shift={(#1)},scale=#2, tdplot_rotated_coords]
          \def\sz{.25}
    	  \coordinate (O) at (0,0,0); 
      	  \coordinate (p0) at (\sz,\sz,0); 
    	  \coordinate (p1) at (\sz,-\sz,0); 
    	  \coordinate (p2) at (-\sz,-\sz,0);
    	  \coordinate (p3) at (-\sz,\sz,0); 
        \fill[color=black!10!white] (p0) -- ++(0,0,-\sz *.5) -- ++(0,-\sz *2,0) -- ++(0,0,\sz *.5) -- cycle;
	\fill[color=black!10!white] (p1) -- ++(-\sz *2,0,0) -- ++(0,0,-\sz *.5) -- ++(\sz *2,0,0) -- cycle;
	\fill[color=black!10!white] (p2) -- ++(0,\sz *2,0) -- ++(0,0,-\sz *.5) -- ++(0,-\sz *2,0) -- cycle;
	\fill[color=black!10!white] (p3) -- ++(\sz *2,0,0) -- ++(0,0,-\sz *.5) -- ++(-\sz *2,0,0) -- cycle;  	    
        \draw[fill=black!10!white] (p0) 
      -- (p1) -- (p2) -- (p3) -- cycle;
  \end{scope}
 }
 %%% \SpaceParallelfuehrung{shift}[scale][rotate x][rotate y][rotate z]
%%%     [scale][rotate x][rotate y][rotate z] are optional
\newcommandx{\SpaceParallelfuehrung}[5][2=1.,3=0.,4=0.,5=0.]{%
	\tdplotsetrotatedcoords{#3}{#4}{#5};
  \begin{scope}[shift={(#1)},scale=#2, tdplot_rotated_coords]
          \def\sz{.25}
    	  \coordinate (O) at (0,0,0); 
      	  \coordinate (p0) at (\sz,\sz,0); 
    	  \coordinate (p1) at (\sz,-\sz,0); 
    	  \coordinate (p2) at (-\sz,-\sz,0);
    	  \coordinate (p3) at (-\sz,\sz,0);
    	  \coordinate (P0) at (\sz,\sz,-\sz *\sz); 
    	  \coordinate (P1) at (\sz,-\sz,-\sz *\sz); 
    	  \coordinate (P2) at (-\sz,-\sz,-\sz *\sz);
    	  \coordinate (P3) at (-\sz,\sz,-\sz *\sz);
        \fill[color=black!10!white] (P0) -- ++(0,0,-\sz *.5) -- ++(0,-\sz *2,0) -- ++(0,0,\sz *.5) -- cycle;
	\fill[color=black!10!white] (P1) -- ++(-\sz *2,0,0) -- ++(0,0,-\sz *.5) -- ++(\sz *2,0,0) -- cycle;
	\fill[color=black!10!white] (P2) -- ++(0,\sz *2,0) -- ++(0,0,-\sz *.5) -- ++(0,-\sz *2,0) -- cycle;
	\fill[color=black!10!white] (P3) -- ++(\sz *2,0,0) -- ++(0,0,-\sz *.5) -- ++(-\sz *2,0,0) -- cycle;  	            
      \draw[fill=black!10!white] (P0) 
      -- (P1) -- (P2) -- (P3) -- cycle;
      \draw[fill=black!10!white] (p0) 
      -- (p1) -- (p2) -- (p3) -- cycle;
  \end{scope}
 }
 
%%% \SpaceFestlager{shift}[scale][rotate x][rotate y][rotate z]
%%%     [scale][rotate x][rotate y][rotate z] are optional
\newcommandx{\SpaceFestlager}[5][2=1.,3=0.,4=0.,5=0.]{%
\tdplotsetrotatedcoords{#3}{#4}{#5};       
  \begin{scope}[shift={(#1)},scale=#2,tdplot_rotated_coords]  
  \coordinate (O) at (0,0,0);
     \def\sz{.25}
      \coordinate (p0) at (\sz,-\sz,-\sz); 
      \coordinate (p1) at (\sz,-\sz,\sz); 
      \coordinate (p2) at (-\sz,-\sz,-\sz);
      \coordinate (p3) at (-\sz,-\sz,\sz); 
      % draw support of hinge D_z   
	\fill[color=black!10!white] (p0) -- ++(0,0,\sz *2) -- ++(0,-\sz *.5,0) -- ++(0,0,-\sz *2) -- cycle;
	\fill[color=black!10!white] (p3) -- ++(\sz *2,0,0) -- ++(0,-\sz *.5,0) -- ++(-\sz *2,0,0) -- cycle;
	\fill[color=black!10!white] (p2) -- ++(0,0,\sz *2) -- ++(0,-\sz *.5,0) -- ++(0,0,-\sz *2) -- cycle;
	\fill[color=black!10!white] (p0) -- ++(-\sz *2,0,0) -- ++(0,-\sz *.5,0) -- ++(\sz *2,0,0) -- cycle;
      \draw[fill=black!10!white] (p0)--(p1)--(p3)--(p2)--cycle;
      \draw (p1)--(O)--(p0);
      \draw (p3)--(O)--(p2);    
  \end{scope}
  \begin{scope}[shift={(#1)},scale=#2] 
  \draw[fill=white] (0,0,0)circle(2pt);
  \end{scope}
 }
 
 %%% \SpaceLoslager{shift}[scale][rotate x][rotate y][rotate z]
 %%% [scale][rotate x][rotate y][rotate z] are optional
 \newcommandx{\SpaceLoslager}[6][2=1.,3=0.,4=0.,5=0.,6=0]{%
   \tdplotsetrotatedcoords{#3}{#4}{#5};       
   \begin{scope}[shift={(#1)},scale=#2,tdplot_rotated_coords]  
     \coordinate (O) at (0,0,0);
     \def\sz{.25}
     \def\sx{1.5}
     \coordinate (p0) at (\sz,-\sz,-\sz); 
     \coordinate (p1) at (\sz,-\sz,\sz); 
     \coordinate (p2) at (-\sz,-\sz,-\sz);
     \coordinate (p3) at (-\sz,-\sz,\sz); 
     \coordinate (P0) at (\sx*\sz,-\sz -\sz *\sz,-\sz); 
     \coordinate (P1) at (\sx*\sz,-\sz -\sz *\sz,\sz); 
     \coordinate (P2) at (-\sx*\sz,-\sz -\sz *\sz,-\sz);
     \coordinate (P3) at (-\sx*\sz,-\sz -\sz *\sz,\sz);
     
     % fix one other direction
     \ifthenelse{\equal{#6}{1}}
     {
       \coordinate (P4) at (-\sx*\sz,-\sz  *.6,\sz);
       \coordinate (P5) at (\sx*\sz,-\sz * .6,\sz);
       \coordinate (P6) at (\sx*\sz,-\sz  *.6,-\sz);
       \coordinate (P7) at (-\sx*\sz,-\sz * .6,-\sz); 
       \draw[fill=black!10!white] (P0)--(P6)--(P7)--(P2)--cycle;
     }
     {}
     % draw support of hinge D_z   
     \fill[color=black!10!white] (P0) -- ++(0,0,\sz *2) -- ++(0,-\sz *.5,0) -- ++(0,0,-\sz *2) -- cycle;
     \fill[color=black!10!white] (P3) -- ++(\sx*\sz *2,0,0) -- ++(0,-\sz *.5,0) -- ++(-\sx*\sz *2,0,0) -- cycle;
     \fill[color=black!10!white] (P2) -- ++(0,0,\sz *2) -- ++(0,-\sz *.5,0) -- ++(0,0,-\sz *2) -- cycle;
     \fill[color=black!10!white] (P0) -- ++(-\sx*\sz *2,0,0) -- ++(0,-\sz *.5,0) -- ++(\sx*\sz *2,0,0) -- cycle;
     \draw[fill=black!10!white] (P0)--(P1)--(P3)--(P2)--cycle;
     \draw[fill=black!10!white] (p0)--(p1)--(p3)--(p2)--cycle;
     \draw (p1)--(O)--(p0);
     \draw (p3)--(O)--(p2);
     
     %% 
     % fix one other direction
     \ifthenelse{\equal{#6}{1}}
     {
       \draw[fill=black!10!white] (P3)--(P4)--(P5)--(P1)--cycle;
     }
     {}
   \end{scope}
   \begin{scope}[shift={(#1)},scale=#2] 
     \draw[fill=white] (0,0,0)circle(2pt);
   \end{scope}
 }
 
%%% \SpaceWegfeder{shift}[scale][rotate x][rotate y][rotate z][spring length]
%%%     [scale][rotate x][rotate y][rotate z][spring length] are optional
%%%     LagerType=0 feste Einspannung
%%%         else other LagerType still have to be added 
\newcommandx{\SpaceWegfeder}[6][2=1.,3=0.,4=0.,5=0.,6=1.]{%
\tdplotsetrotatedcoords{#3}{#4}{#5};  
  \def\springlength{#6}
  \def\baline{.25*\springlength}
  \begin{scope}[shift={(#1)},scale=#2,tdplot_rotated_coords] 
    \SpaceParallelfuehrung{#1}[#2][#3-180][#4-90][#5];
    \draw(0,0,0)--(\baline,0,0);
    \draw[decoration={aspect=0.3, segment length=6, amplitude=5pt,coil},decorate] (\baline,0.,0) -- (\baline+\springlength,0.,0); 
    \draw(\baline+\springlength,0,0)--(2*\baline+\springlength,0,0);
    \draw[fill=white](2*\baline+\springlength,0,0)circle(2pt);
  \end{scope}
}

%%% \SpaceBemassung{point1}{point2}{label}[scale][labelpos] 
%%%     [scale][labelpos]   are optional
% orientation = 0 ... go directly along the line from point1 to point2
% orientation = 1 ... go horizontally (direction 1) from point1 to point2
% orientation = 2 ... go vertically   (direction 2) from point1 to point2

\newcommandx{\SpaceBemassung}[5][4=1.,5={pos=.5, above}]{
  %
  \draw (#1)--(#2)node[#5]{#3};
  \begin{scope}[shift={(#1)}]
	\draw (-#4,0,0)--(#4,0,0);
	\draw (0,-#4,0)--(0,#4,0);
	\draw (0,0,-#4)--(0,0,#4);
  \end{scope}
  \begin{scope}[shift={(#2)}]
	\draw (-#4,0,0)--(#4,0,0);
	\draw (0,-#4,0)--(0,#4,0);
	\draw (0,0,-#4)--(0,0,#4);
  \end{scope}
}

