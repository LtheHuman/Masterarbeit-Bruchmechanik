% Bemassung
%================================================

%%% \Bemassung{point1}{point2}{label}[offset][orientation][labelpos] 
%%%     [offset][orientation][labelpos]   are optional
% orientation = 0 ... go directly along the line from point1 to point2
% orientation = 1 ... go horizontally (direction 1) from point1 to point2
% orientation = 2 ... go vertically   (direction 2) from point1 to point2

\newcommandx{\Bemassung}[6][4=1.,5=0,6={pos=.5, above}]{
  %
  \ifthenelse{\equal{#5}{0}}%
    % true: go along the line from point1 to point2
    {
      \draw[|<->|, very thin] let \p1 = (#1), \p2 = (#2) in
      ($(#1)!#4 cm!(\x1-\y2+\y1,\y1+\x2-\x1)$) --++ (\x2-\x1,\y2-\y1)
      node[#6]{#3};
    } %
    % else: check again
    {
      \ifthenelse{\equal{#5}{1}}%
      % true: go horizontally from point1 to point2
      {
        \draw[|<->|, very thin] let \p1 = (#1), \p2 = (#2) in
        ($(\x1,#4)$) -- ($(\x2,#4)$) node[#6]{#3};
      } %
      % else: go vertically from point1 to point2
      {
        \draw[|<->|, very thin] let \p1 = (#1), \p2 = (#2) in
        ($(#4,\y1)$) -- ($(#4,\y2)$) node[#6]{#3};
      }
    }
}



