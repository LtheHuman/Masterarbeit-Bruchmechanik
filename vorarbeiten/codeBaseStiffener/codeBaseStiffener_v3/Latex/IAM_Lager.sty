%%% \Daempfer{shift}[rotate][scale][LagerType][length] 
%%%     [rotate][scale][LagerType][length]  are optional
%%%     LagerType=0 feste Einspannung
%%%         else other LagerType still have to be added 

\newcommandx{\Daempfer}[5][2=0,3=1.,4=0,5=1.6]{
  \def\length{#5}
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
    % dash
    \draw (0,0.) -- (.45*\length,0.);
    \draw (.45*\length,0.1*\length) -- (.45*\length,-0.1*\length);
    % pot
    \draw (.55*\length,0.) -- (\length,0.);
    \draw (.55*\length,0.15*\length) -- (.55*\length,-0.15*\length);
    \draw (.35*\length,0.15*\length) -- (.55*\length,0.15*\length);
    \draw (.35*\length,-0.15*\length) -- (.55*\length,-0.15*\length);

    \ifthenelse{\equal{#4}{0}}%
    {\Einspannung{(\length,0)}[90][#3][#4]}{}%
    \ifthenelse{\equal{#4}{1}}%
    {\Parallelfuehrung{(\springlength,0)}[90][#3][#4]}
    {}
  \end{scope}
}



