\newcommandx{\Schnittgroessen}[6][2=0,3=0,4=0,5=1.,6=]{
  \def\snakeLength{.3}
  \def\snakeAmplitude{0.22}
  \begin{scope}[shift={(#1)},rotate=#4,scale=#5]
    % x-z positiv
    \ifthenelse{\equal{#3}{0}}{
      \draw[semithick,->] (0.2,0.5) -- +(0,-1)
      node[at end, below, xshift=2mm]{$Q_{z_{#6}}(#2)$};
      \draw[semithick,->] (0.5,-0.55) arc(-30:30:1.1)
      node[right,yshift=1mm]{$M_{y_{#6}}(#2)$};
      \draw[semithick,->] (0.1,0) -- +(1,0)
      node[at end,below right]{$N_{#6}(#2)$};
    } {}
    % x-z negativ
    \ifthenelse{\equal{#3}{1}}{
      \draw[semithick,->] (-0.2,-0.5) -- +(0,1) node[right]{$Q_{z_{#6}}(#2)$};
      \draw[semithick,->] (-0.5,-0.55) arc(210:150:1.1) node[above]{$M_{y_{#6}}(#2)$};
      \draw[semithick,->] (-0.1,0) -- +(-1,0) node[left]{$N_{#6}(#2)$};
    } {}
    % x-y positiv
    \ifthenelse{\equal{#3}{2}}{
      \draw[semithick,<-] (0.2,-0.5) -- +(0,1) node[left]{$Q_{y_{#6}}(#2)$};
      \draw[semithick,<-] (0.5,-0.55) arc(-30:30:1.1) node[right]{$M_{z_{#6}}(#2)$};
      \draw[semithick,->] (0.1,0) -- +(1,0) node[right ]{$N_{#6}(#2)$};
    } {}
    % x-y negativ
    \ifthenelse{\equal{#3}{3}}{
      \draw[semithick,->] (-0.2,-0.5) -- +(0,1) node[right]{$Q_{y_{#6}}(#2)$};
      \draw[semithick,<-] (-0.5,-0.55) node[below]{$M_{z_{#6}}(#2)$} arc(210:150:1.1) ;
      \draw[semithick,->] (-0.1,0) -- +(-1,0) node[left]{$N_{#6}(#2)$};
    } {}
  \end{scope}
}

%================================================
% Belastung normal auf einen Stab
%================================================
%%% \Belastung{xPos}{yPos}{magnitude}[arrows][hh] 
%%%     [arrows][hh]  are optional
% parameter \x in [0,1]
% 1 ... Funktion der x-Koordinate, use parameter \x
% 2 ... Funktion der y-Koordinate, use parameter \x
% 3 ... magnitude, use parameter \x 
% 4 ... number of arrows
% 5 ... numerical parameter
% Example usage:
\iffalse
\documentclass[tikz]{standalone}
\usepackage{IAM_Lager}
\begin{document}
\begin{tikzpicture}[>=latex]
\draw[thick] (0,0) -- (3,4);
\Belastung{3*\x}{4*\x}{0.3+\x};
%\Belastung{3*cos(\x*3.14)}{4*sin(\x*3.14)}{0.3+\x}[5][0.1];
\Belastung{6+3*cos(\x*90)}{4*sin(\x*90)}{0.3+\x};          
\end{tikzpicture}		
\end{document}
\fi
\newcommandx{\Belastung}[5][4=5,5=0.01]{
% define a counter for unique function names
\makeatletter
\ifcsname c@IAMcounBel\endcsname
\else
\newcounter{IAMcounBel}
\fi
\makeatother

\tikzmath{
	\hh = #5;
	\eps = 0.001; % epsilon to prevent division by zero
	function funcX\theIAMcounBel(\x) {return #1;};
	function funcY\theIAMcounBel(\x) {return #2;};
	function funcP\theIAMcounBel(\x) {return #3;};
	% tangent vector length squared (adding epsilon before sqrt is more numerically stable)
	function funcLenSq\theIAMcounBel(\x) {
		return max((funcY\theIAMcounBel(\x+\hh)-funcY\theIAMcounBel(\x))*(funcY\theIAMcounBel(\x+\hh)-funcY\theIAMcounBel(\x))+(funcX\theIAMcounBel(\x+\hh)-funcX\theIAMcounBel(\x))*(funcX\theIAMcounBel(\x+\hh)-funcX\theIAMcounBel(\x)), \eps);
	};
}
% plot the line using numerical differentiation for the normal vector
\draw[] plot[domain=0:1,samples=25,smooth] (
{funcX\theIAMcounBel(\x)-funcP\theIAMcounBel(\x) * (funcY\theIAMcounBel(\x+\hh)-funcY\theIAMcounBel(\x)) / sqrt(funcLenSq\theIAMcounBel(\x))},
{funcY\theIAMcounBel(\x)+funcP\theIAMcounBel(\x)*(funcX\theIAMcounBel(\x+\hh)-funcX\theIAMcounBel(\x))/ sqrt(funcLenSq\theIAMcounBel(\x))});


% plot the arrows using numerical differentiation for the normal vector
\pgfmathsetmacro{\epsL}{0.1} % epsilon to prevent plotting only arrow heads
\foreach \i in {0,1,...,#4}{
	%\pgfmathsetmacro{\jn}{(funcY\theIAMcounBel(\i/#4+\hh)-funcY\theIAMcounBel(\i/#4)};
	%\pgfmathsetmacro{\jnx}{(funcX\theIAMcounBel(\i/#4+\hh)-funcX\theIAMcounBel(\i/#4)};
	\pgfmathparse{abs(funcP\theIAMcounBel(\i/#4+\hh))>\epsL ? 1 : 0}
	\ifnum\pgfmathresult=1
		\draw[<-] ({funcX\theIAMcounBel(\i/#4)},{funcY\theIAMcounBel(\i/#4)}) -- (
		{funcX\theIAMcounBel(\i/#4)-funcP\theIAMcounBel(\i/#4+\hh) * (funcY\theIAMcounBel(\i/#4+\hh)-funcY\theIAMcounBel(\i/#4)) / sqrt(funcLenSq\theIAMcounBel(\i/#4))},
		{funcY\theIAMcounBel(\i/#4)+funcP\theIAMcounBel(\i/#4+\hh)*(funcX\theIAMcounBel(\i/#4+\hh)-funcX\theIAMcounBel(\i/#4))/ sqrt(funcLenSq\theIAMcounBel(\i/#4))})
		%node {\jn,\jnx}
		;
	\fi
}
% increment the counter
\stepcounter{IAMcounBel}
}


