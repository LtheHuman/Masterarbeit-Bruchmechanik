%%% \Festlager{shift}[rotate][scale][isFullHinge]
%%%     [rotate][scale][isFullHinge] are optional
%%%     isFullHinge=1 true is default value
%%%     isFullHinge=0 false means (Halbgelenk)
\newcommandx{\Festlager}[4][2=0,3=1.,4=1]{%
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]   
    \draw[thick] (0,0) -- (-0.25,-0.4) -- (0.25,-0.4) -- (0,0);
    % draw hinge
    \ifthenelse{\equal{#4}{0}}%
    % false: draw semi circle
    {\Halbgelenk{(0,0)}}%
    % true: draw full circle
    {\Vollgelenk{(0,0)}}
    % draw separator
    \draw[thick] (-0.36,-0.4) -- +(0.72,0.);
    % draw lines at footing
    \def\step{0.1}
    \def\stepp{0.4}
    % draw lines domain 1 (upper left corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (-.35+\x,-.4) -- (-.35,-.4-\x);}
    % draw lines domain 2 (center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (-.35+\x,-.4) -- (-.65+\x,-.7);}
    % draw lines domain 3 (lower right corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (.35,-.4-\y) -- (.05+\y,-.7);}   
  \end{scope}
}

%%% \Loslager{shift}[rotate][scale][isFullHinge]
%%%     [rotate][scale][isFullHinge] are optional
%%%     isFullHinge=1 true is default value
%%%     isFullHinge=0 false means (Halbgelenk)
\newcommandx{\Loslager}[4][2=0,3=1.,4=1]{
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3] 
    \draw[thick] (0,0) -- (-0.25,-0.4) -- (0.25,-0.4) -- (0,0);
    % draw hinge
    \ifthenelse{\equal{#4}{0}}%
    % false: draw semi circle
    {\Halbgelenk{(0.,0.)}}%
    % true: draw full circle
    {\Vollgelenk{(0.,0.)}}
    % draw separators
    \draw[thick] (-0.36,-0.4) -- +(0.72,0.);
    \draw[thick] (-0.36,-0.5) -- +(0.72,0.);
    % draw lines at footing
    \def\step{0.1}
    \def\stepp{0.4}
    % draw lines domain 1 (upper left corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (-.35+\x,-.5) -- (-.35,-.5-\x);}
    % draw lines domain 2 (center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (-.35+\x,-.5) -- (-.65+\x,-.8);}
    % draw lines domain 3 (lower right corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (.35,-.5-\y) -- (.05+\y,-.8);}         
  \end{scope}
}

%%% \Einspannung{shift}[rotate][scale]
%%%     [rotate][scale] are optional
\newcommandx{\Einspannung}[3][2=0,3=1.]{
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
    % draw separators
    \draw[thick] (-0.36,-0.0) -- +(0.72,0.);
    % draw lines at footing
    \def\step{0.1}
    \def\stepp{0.4}
    % draw lines domain 1 (upper left corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (-.35+\x,-.0) -- (-.35,-.0-\x);}
    % draw lines domain 2 (center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (-.35+\x,-.0) -- (-.65+\x,-.3);}
    % draw lines domain 3 (lower right corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (.35,-.0-\y) -- (.05+\y,-.3);}         
  \end{scope}
}

%%% \Parallelfuehrung{shift}[rotate][scale]
%%%     [rotate][scale] are optional
\newcommandx{\Parallelfuehrung}[3][2=0,3=1.]{
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
    % draw separators
    \draw[thick] (-0.36,-0.0) -- +(0.72,0.);
    \draw[thick] (-0.36,-0.1) -- +(0.72,0.);
    % draw lines at footing
    \def\step{0.1}
    \def\stepp{0.4}
    % draw lines domain 1 (upper left corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (-.35+\x,-.1) -- (-.35,-.1-\x);}
    % draw lines domain 2 (center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (-.35+\x,-.1) -- (-.65+\x,-.4);}
    % draw lines domain 3 (lower right corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (.35,-.1-\y) -- (.05+\y,-.4);}         
  \end{scope}
}


%%% \Schiebehuelse{shift}[rotate][scale]
%%% [rotate][scale] are optional
\newcommandx{\Schiebehuelse}[3][2=0,3=1.]{
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
    % draw separators
    \draw[thick] (-0.36,0.1) -- +(0.72,0.);
    \draw[thick] (-0.36,-0.1) -- +(0.72,0.);
    % draw lines at footing
    \def\step{0.1}
    \def\stepp{0.4}
    % draw lines domain 1 (lower footing upper left corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (-.35+\x,-.1) -- (-.35,-.1-\x);}
    % draw lines domain 2 (lower footing center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (-.35+\x,-.1) -- (-.65+\x,-.4);}
    % draw lines domain 3 (lower footing lower right corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (.35,-.1-\y) -- (.05+\y,-.4);}         
    % draw lines domain 4 (upper footing lower right corner)
    \foreach \x in {0.,\step,...,.3}{
      \draw[thin] (.35-\x,.1) -- (.35,.1+\x);}
    % draw lines domain 2 (upper footing center)
    \foreach \x in {.3,\stepp,...,.69}{
      \draw[thin] (.35-\x,.1) -- (.65-\x,.4);}
    % draw lines domain 3 (upper footing upper left corner)
    \foreach \y in {0.,\step,...,.3}{
      \draw[thin] (-.35,.1+\y) -- (-.05-\y,.4);}         
  \end{scope}
}



%================================================
% hinge
