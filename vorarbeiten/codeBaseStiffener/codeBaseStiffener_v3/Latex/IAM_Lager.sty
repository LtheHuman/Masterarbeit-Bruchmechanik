% Koordinatensystem
%================================================

%%% \Koordinatensystem{shift}[scale][orientation][xlength][ylength] 
%%%             [xlabel][ylabel][xlabelpos][ylabelpos]
%%% 
%%%     [scale][orientation][xlength][ylength][xlabel][ylabel]
%%%     [xlabelpos][ylabelpos] are optional 
% orientation = 0 ... out of plane
% orientation = 1 ... towards plane
% orientation = 2 ... no orientation

\newcommandx{\Koordinatensystem}[9][2=1.,3=0,4=0.9,5=-0.9,
                        6={\small$x$},7={\small$z$},
                        8={at end, below},9={at end,left}]{
  \begin{scope}[shift={(#1)},scale=#2]
    \def\xlength{#4}
    \def\ylength{#5}
    \def\rr{0.07}

    \draw[very thin,->] (0,0) -- +(\xlength,0.) node[#8]{#6};
    \draw[very thin,->] (0,0) -- +(0.,\ylength) node[#9]{#7};
    
    \ifthenelse{\equal{#3}{0}} %
    % draw out of plane
    { 
      \filldraw[fill=white,draw=black, semithick] (0,0) circle (\rr);
      \fill[color=black] (0,0) circle (\rr/4);
    } %
    { \ifthenelse{\equal{#3}{1}} %
      % draw towards plane
      {        
        \filldraw[fill=white,draw=black,  semithick] (0,0) circle (\rr);
        \draw[color=black, very thin] ({-\rr/sqrt(2)},{-\rr/sqrt(2)}) -- 
        ({\rr/sqrt(2)},{\rr/sqrt(2)});
        \draw[color=black, very thin] ({\rr/sqrt(2)},-{\rr/sqrt(2)}) -- 
        ({-\rr/sqrt(2)},{\rr/sqrt(2)});
      } %
      % else: no orientation, but towards plane  
      {}
    }
  \end{scope}
}


