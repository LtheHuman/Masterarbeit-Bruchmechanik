\def\hingeRadius{0.09}
%%% \Vollgelenk{shift}[scale]  
%%%     [scale] is optional 
\newcommandx{\Vollgelenk}[3][2=0,3=1.]{  
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3] 
    \draw[thick, fill=white] (0.,0.) circle (\hingeRadius);
  \end{scope}
}

%%% \Halbgelenk{shift}[rotate][scale] 
%%%     [rotate][scale] are optional

\newcommandx{\Halbgelenk}[3][2=0,3=1.]{
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3] 
    \def\offset{-0.015};
    \draw[thick, fill=white] ($(\hingeRadius,0.)+(0.0,\offset)$) 
    arc (0:-180:\hingeRadius);
  \end{scope}
}

%%% \Kugelgelenk{shift}[radius]  
%%%     [radius] is optional 
\newcommandx{\Kugelgelenk}[2][2=1.]{ 
\draw (#1)circle(2pt*#2);
\fill[color=white] (#1)circle(2pt*#2); 
}


%================================================
% spring style 
%================================================

%%% \Wegfeder{shift}[rotate][scale][LagerType][springlength] 
%%%     [rotate][scale][LagerType][springlength]  are optional
%%%     LagerType=0 feste Einspannung
%%%         else other LagerType still have to be added 

\newcommandx{\Wegfeder}[5][2=0,3=1.,4=0,5=1.6]{
  \def\springlength{#5}
  \begin{scope}[shift={(#1)},rotate=#2,scale=#3]
    \draw[snake=zigzag,line before snake=3mm, line after snake=3mm,
    segment length=6,
     segment amplitude=5pt,
     %join=round,
      thin] 
    (0,0.) -- (\springlength,0.); 
    \ifthenelse{\equal{#4}{0}}{\Einspannung{(\springlength,0)}[90][#3][#4]}{}
    \ifthenelse{\equal{#4}{1}}{\Parallelfuehrung{(\springlength,0)}[90][#3][#4]}
    {}
  \end{scope}
}


%%% \RelativWegfeder{point1}{point2}
\newcommandx{\RelativWegfeder}[2]{
	\draw
	let
	\p1=(#1), \p2=(#2), \n1={veclen(\y2-\y1,\x2-\x1)}
	in
	[snake=zigzag,line before snake=3mm, line after snake=3mm,
		segment length= 0.1 * \n1,
		segment amplitude=5pt,join=round, thin] (#1) -- (#2);		
		\Vollgelenk{#1};
		\Vollgelenk{#2};
}


%%% \RelativDrehfeder{shift}[scale][start domain][end domain] 
%%% [rotate][scale][start domain][end domain]  are optional
\newcommandx{\RelativDrehfeder}[4][2=1.,3=0, 4=25.12]{ 
  % 15.708=5*\pi, 25.12=8*\pi
  % spring spiral]
  \begin{scope}[shift={(#1)},scale=#2]		
    \def\xshift{-0.2}
    \def\yshift{-0.4}
    \pgfmathsetmacro\xCoordSprEnd{- #4 * #4 * 0.001};
    \draw[thin] [domain=#3:#4,variable=\t,smooth,
    samples=500] plot ({\t r}: {-0.001*\t*\t});
  \end{scope}  
}



\newcommandx{\Drehfeder}[5][2=0,3=1.,4=0,5=1]{
	% spring spiral]
	\begin{scope}[shift={(#1)},rotate=#2,scale=#3]
		
		% Define variables to draw the support of the spring
		\ifthenelse{\equal{#4}{0}}%
		% spring is not connected to any kind of 'LagerType'
		{ 
			\def\xshift{0.7};
			\def\yshift{-0.4};
			\def\startDomain{0.};
			% xPosition of the upper left corner
			\def\xposRectangleL{-0.3}; 
			% xPosition of the upper right corner
			\def\xposRectangleR{0.3};
			\def\gapL{-0.01};
			\def\gapR{0.01};
			% Length of Rectangle = 0.6
			\pgfmathsetmacro\rectangleLength{\xposRectangleR-\xposRectangleL};
		}%
		% spring is connected to 'Loslager' or 'Festlager'
		{ \def\xshift{0.709};
			\def\startDomain{15.708};
			
			\ifthenelse{\equal{#5}{1}}%
			{
				\def\gapL{-0.01};
				\def\gapR{0.0};
				% xPosition of the upper left corner
				\def\xposRectangleL{-0.3}; 
				% xPosition of the upper right corner
				\def\xposRectangleR{0.1};
			}{}
			\ifthenelse{\equal{#5}{-1}}%
			{ \def\gapL{0.}
				\def\gapR{0.01}
				% xPosition of the upper left corner        
				\def\xposRectangleL{-.1}
				% xPosition of the upper right corner
				\def\xposRectangleR{0.3}
			}{}
			\pgfmathsetmacro\rectangleLength{\xposRectangleR-\xposRectangleL};
			
			% specification of 'Loslager'
			\ifthenelse{\equal{#4}{1}}%
			{ \def\yshift{-0.5} }{}
			%  % specification of 'Festlager'
			\ifthenelse{\equal{#4}{2}}%
			{ \def\yshift{-0.4} }{}
		}
		% spring with FullHinge
		\ifthenelse{\equal{#4}{3}}%
		% spring is not connected to any kind of 'LagerType'
		{ 
			\def\xshift{0.7}
			\def\yshift{-0.4}
			\Vollgelenk{#1}
			\def\startDomain{15.708}
			% xPosition of the upper left corner
			\def\xposRectangleL{-0.3}
			% xPosition of the upper right corner
			\def\xposRectangleR{0.3}
			\def\gapL{-0.01}
			\def\gapR{0.01}
			% Length of Rectangle = 0.6
			\pgfmathsetmacro\rectangleLength{\xposRectangleR-\xposRectangleL}
		}%
		
		\pgfmathsetmacro\xCoordSprEnd{-25.12*25.12*0.001};
		%\begin{scope}[shift={(#1)},scale=.7]
		\begin{scope}[shift={(\xCoordSprEnd*\xshift*#5+\xshift/2+0.1 , 0.)},scale=.7]
			% domain: start_value: end_value(=8*\pi) 
			\draw[thin] [domain=\startDomain:25.1327412,variable=\t,smooth,
			samples=500] plot ({\t*#5 r}: {-0.001*\t*\t*#5});
			%\draw[thin] (#1)--++(0.,-0.4*1.4);
			\draw[thin] (\xCoordSprEnd*#5,0.01)--++(0.,-0.4*1.4);
		\end{scope}
		
		%		 Draw the support of the spring
		\def\rectangleHigh{0.3}
		%\begin{scope}[shift={(#1)},xscale=1.]
		\begin{scope}[shift={(\xCoordSprEnd*\xshift*#5,\yshift)},xscale=1.]
			% draw separators
			\draw[thick] (\xposRectangleL+\gapL,0.0) -- 
			(\xposRectangleR+\gapR,0.);   
			\ifthenelse{\equal{#4}{1}}% if Loslager connected
			{\draw[thick] (\xposRectangleL-0.01,0.1) --(\xposRectangleR+\gapR,0.1);}{}
			% draw lines at footing
			\def\step{0.1}
			\pgfmathsetmacro\stepTwo{\rectangleHigh+\step}
			% draw lines domain 1 (upper left corner)
			\foreach \x in {0.,\step,...,\rectangleHigh}{
				\draw[thin] (\xposRectangleL+\x,0.) -- 
				(\xposRectangleL,-\x);}
			% draw lines domain 2 (center)
			\foreach \x in {\rectangleHigh,\stepTwo,...,\rectangleLength}{
				\draw[thin] (\xposRectangleL+\x,0.) -- 
				(-\rectangleHigh+\xposRectangleL+\x,-\rectangleHigh);}
			% draw lines domain 3 (lower right corner)
			\foreach \y in {0.,\step,...,\rectangleHigh}{
				\draw[thin] (\xposRectangleR,-\y) -- 
				+(-\rectangleHigh+\y,-\rectangleHigh+\y);} 
		\end{scope}
	\end{scope}  
}


