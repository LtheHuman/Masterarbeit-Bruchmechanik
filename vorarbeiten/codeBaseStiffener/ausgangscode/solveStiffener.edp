macro bilaplacien(u, v) (dxx(u)*dxx(v) + dyy(u)*dyy(v) + 2.*dxy(u)*dxy(v))	// end of macro

fespace Wh(Th, P2);
fespace Vh(Th, HCT);	// HCT finite element space
Vh [u0, ux0, uy0], [v, vx, vy];
solve bilap ([u0, ux0, uy0], [v, vx, vy])
    = int2d(Th, qft=qfHCT5)(D*bilaplacien(u0, v)) // plate problem
    + int1d(Th, 2)(EI*(dxx(u0)*N.y^2 - 2*dxy(u0)*N.x*N.y+dyy(u0)*N.x^2)*(dxx(v)*N.y^2 - 2*dxy(v)*N.x*N.y+dyy(v)*N.x^2)) // beam problem
    - int2d(Th)(f*v) // loading
    + on( 1, u0=0, ux0=0, uy0=0);
//plot(u0,fill=1,cmm="displacement");
real compliance = int2d(Th)(f*u0);
cout << "compliance: " << compliance << endl;